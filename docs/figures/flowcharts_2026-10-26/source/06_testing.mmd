flowchart TD
  protocol[/"冻结数据与测试协议<br/>事件定义 / 分组 split / 因果边界"/]
  unit["模块正确性测试<br/>坐标 / 掩码 / 几何 / 时间 / 梯度"]
  integration["接口与故障注入测试<br/>乱序 / 丢包 / 旧预测 / 求解失败"]
  passed{"基础正确性与<br/>夹具验收通过？"}
  repair["定位失败并修复<br/>保留输入、日志与复现用例"]
  open["真实数据开放环评测<br/>CV / GRU / HiVT / RC-STGT"]
  closed["CARLA 同场景配对闭环<br/>无干预 / TTC-AEB / 预测AEB / AEB+AES"]
  ablation["模型消融与风险比较<br/>相同输入与公平训练协议"]
  robust["鲁棒性 / 泛化 / 协同扩展<br/>未见路口 · 遮挡 · 延迟 · 失联"]
  metrics["预测、预警与闭环指标分开<br/>碰撞 / 越界 / 效率 / 实际耗时"]
  statistics["场景级配对统计<br/>至少 3 训练种子 · bootstrap 区间"]
  deliver(["原始结果 → 图表 → 论文结论<br/>可追溯配置 / 权重 / 场景 / run_id"])
  protocol --> unit
  unit --> integration
  integration --> passed
  passed -->|否| repair
  repair -.->|回归检查| unit
  passed -->|是| open
  passed -->|是| closed
  open --> ablation
  closed --> robust
  ablation --> metrics
  robust --> metrics
  metrics --> statistics
  statistics --> deliver
  classDef process fill:#F4F7FB,stroke:#71859E,color:#22354F,stroke-width:1.2px
  class unit,integration,metrics,statistics process
  classDef input fill:#EDF7F2,stroke:#38775E,color:#22354F,stroke-width:1.2px
  class protocol input
  classDef model fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  classDef risk fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  classDef decision fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  class passed decision
  classDef control fill:#EAF3F5,stroke:#397381,color:#22354F,stroke-width:1.2px
  classDef fallback fill:#FDEEEA,stroke:#A35540,color:#22354F,stroke-width:1.2px
  class repair fallback
  classDef evaluation fill:#F1EFF9,stroke:#76628D,color:#22354F,stroke-width:1.2px
  class open,closed,ablation,robust evaluation
  classDef output fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  class deliver output
