flowchart TD
  input[/"当前本车状态 + 本地观测<br/>路侧预测与原始绝对时间"/]
  time["检查控制前缀与消息时效<br/>对齐到共同计划起点"]
  coverage{"预测有效且信息<br/>覆盖完整规划？"}
  degraded["降级：本地预测 / 风险记忆<br/>谨慎减速与本地紧急监控"]
  candidate["生成本车候选轨迹<br/>参考行驶 / 制动 / 左右避让 / 组合"]
  constraints["过滤不可行动作<br/>道路 · 侧后车 · 转角 · jerk · 附着"]
  collision["SAT 车体碰撞 + 区间细分<br/>逐目标 · 逐模式 · 完整轨迹事件"]
  score["模式加权得到车对风险<br/>比较 max / sum 评分与严重度"]
  feasible{"存在低风险的<br/>可执行候选？"}
  select["选择风险较低动作<br/>相近时兼顾舒适与效率"]
  mitigate["未找到安全候选<br/>执行可行减损并记录失败"]
  normal["参考行驶 / 提前减速"]
  aeb["AEB：制动"]
  aes["AES：转向或制动转向<br/>侧向通道必须可观察且可行"]
  execute(["车端控制与滚动复核<br/>路侧结果作为辅助信息"])
  input --> time
  time --> coverage
  coverage -->|是| candidate
  coverage -->|否| degraded
  candidate --> constraints
  constraints --> collision
  collision --> score
  score --> feasible
  feasible -->|是| select
  feasible -->|否| mitigate
  select -->|选中动作| normal
  select -->|选中动作| aeb
  select -->|选中动作| aes
  normal --> execute
  aeb --> execute
  aes --> execute
  mitigate --> execute
  degraded --> execute
  classDef process fill:#F4F7FB,stroke:#71859E,color:#22354F,stroke-width:1.2px
  class time,candidate,constraints process
  classDef input fill:#EDF7F2,stroke:#38775E,color:#22354F,stroke-width:1.2px
  class input input
  classDef model fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  classDef risk fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  class collision,score,select risk
  classDef decision fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  class coverage,feasible decision
  classDef control fill:#EAF3F5,stroke:#397381,color:#22354F,stroke-width:1.2px
  class normal,aeb,aes control
  classDef fallback fill:#FDEEEA,stroke:#A35540,color:#22354F,stroke-width:1.2px
  class degraded,mitigate fallback
  classDef evaluation fill:#F1EFF9,stroke:#76628D,color:#22354F,stroke-width:1.2px
  classDef output fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  class execute output
