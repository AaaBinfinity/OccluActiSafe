flowchart TD
  x[/"双来源历史 X<br/>[B, N, 20, 2, 12]"/]
  mask[/"特征 / 观测 / 来源掩码<br/>age · 定位质量 · sample_dt"/]
  encode["特征清理与来源编码<br/>MLP + source embedding"]
  gate["可靠性门控融合<br/>MaskedSoftmax · 无效来源权重为 0"]
  temporal["时间 Transformer × 2<br/>[B·N, 20, 128] · 8 头"]
  spatial["车辆空间图注意力 × 2<br/>邻近 / 冲突关系 · 8 头"]
  map[/"车道折线与当前信号<br/>点级 MLP · masked pooling"/]
  map_attn["地图 Cross-Attention<br/>空地图使用 no_map token"]
  modes["K = 6 个模式 embedding<br/>逐车解码完整未来"]
  traj(["未来轨迹均值<br/>[B, N, 6, 40, 2]"])
  prob(["模式 logits → Softmax<br/>[B, N, 6]"])
  loss["训练损失：赢家回归 + 模式分类<br/>未来有效掩码 · AdamW"]
  gt["未来真值轨迹<br/>仅训练 / 评测使用"]
  x --> encode
  mask --> encode
  encode --> gate
  gate --> temporal
  temporal --> spatial
  spatial --> map_attn
  map --> map_attn
  map_attn --> modes
  modes --> traj
  map_attn -->|模式权重分支| prob
  traj -.->|训练时| loss
  prob -.->|训练时| loss
  gt -.->|监督标签| loss
  classDef process fill:#F4F7FB,stroke:#71859E,color:#22354F,stroke-width:1.2px
  class encode process
  classDef input fill:#EDF7F2,stroke:#38775E,color:#22354F,stroke-width:1.2px
  class x,mask,map input
  classDef model fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  class gate,temporal,spatial,map_attn,modes model
  classDef risk fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  classDef decision fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  classDef control fill:#EAF3F5,stroke:#397381,color:#22354F,stroke-width:1.2px
  classDef fallback fill:#FDEEEA,stroke:#A35540,color:#22354F,stroke-width:1.2px
  classDef evaluation fill:#F1EFF9,stroke:#76628D,color:#22354F,stroke-width:1.2px
  class loss,gt evaluation
  classDef output fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  class traj,prob output
