      "direction": "TB",
      "nodes": [
        {"id":"real","label":"公开真实轨迹\nV2X-Seq TFD","kind":"input"},
        {"id":"sim","label":"CARLA 场景与双视角视频\n遮挡 / 冲突 / 通信扰动","kind":"input"},
        {"id":"data","label":"数据治理与样本构建\n坐标统一 · 因果窗口 · 分组划分"},
        {"id":"learn","label":"预测模型训练与对比\nCV / GRU / HiVT / RC-STGT","kind":"model"},
        {"id":"freeze","label":"验证集校准与参数冻结\n模型 · 风险口径 · 触发阈值","kind":"model"},
        {"id":"observe","label":"在线车路感知与消息对齐\n仅使用当时已到达的信息","kind":"input"},
        {"id":"forecast","label":"路侧多模态轨迹预测\n仿真起步预测 4 s","kind":"model"},
        {"id":"risk","label":"车端候选生成与风险评估\n统一时域 · 车体几何 · 道路约束","kind":"risk"},
        {"id":"action","label":"选择本车动作\n参考行驶 / AEB / AES / 组合","kind":"risk"},
        {"id":"control","label":"MPC 与执行器控制\n车端最终复核及失效回退","kind":"control"},
        {"id":"step","label":"CARLA 执行下一周期\n更新本车状态与传感器观测","kind":"control"},
        {"id":"truth","label":"评测专用真值与事件\n禁止直接进入在线控制","kind":"evaluation"},
        {"id":"evaluate","label":"开放环 / 闭环 / 消融 / 鲁棒性\n配对统计与失败案例分析","kind":"evaluation"},
        {"id":"deliver","label":"论文 · 系统演示 · 复现材料\n原始日志支撑研究结论","kind":"output"}
      ],
