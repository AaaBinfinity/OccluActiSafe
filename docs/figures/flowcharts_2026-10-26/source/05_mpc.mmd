flowchart TD
  state[/"本车当前状态与参考候选<br/>只使用已可用信息"/]
  delay["补偿执行 / 排队延迟<br/>状态传播到 plan_start_time"]
  problem["构建六状态非线性 MPC<br/>RK4 · 0.1 s × 30 步 · 3 s"]
  hard["跟踪代价与约束<br/>车体道路 · 加速度 · jerk · 转角 · 附着"]
  solve["CasADi / IPOPT 优化<br/>常驻 worker + 外层截止"]
  ok{"及时返回有效解<br/>且数值有限？"}
  verify["求解后区间与风险复核<br/>含 0.05 s 执行子步"]
  safe{"轨迹与约束<br/>复核通过？"}
  recover["重新核查旧计划 / 回退候选<br/>稳定转向减速或受限回正"]
  first["仅执行下一 0.05 s 控制段<br/>加速度 / 转角 → 前馈 PID 与映射"]
  carla["提交 throttle / brake / steer<br/>CARLA 更新状态与观测"]
  log["记录控制、残差、耗时与失败<br/>实际响应另行评测"]
  state --> delay
  delay --> problem
  problem --> hard
  hard --> solve
  solve --> ok
  ok -->|是| verify
  ok -->|否 / 超时| recover
  verify --> safe
  safe -->|是| first
  safe -->|否| recover
  recover -->|已复核的可执行回退| first
  first --> carla
  carla -.->|下一周期| state
  carla -.->|独立记录| log
  classDef process fill:#F4F7FB,stroke:#71859E,color:#22354F,stroke-width:1.2px
  class delay,hard,verify process
  classDef input fill:#EDF7F2,stroke:#38775E,color:#22354F,stroke-width:1.2px
  class state input
  classDef model fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
  class problem,solve model
  classDef risk fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  classDef decision fill:#FFF3DC,stroke:#A36C1A,color:#22354F,stroke-width:1.2px
  class ok,safe decision
  classDef control fill:#EAF3F5,stroke:#397381,color:#22354F,stroke-width:1.2px
  class first,carla control
  classDef fallback fill:#FDEEEA,stroke:#A35540,color:#22354F,stroke-width:1.2px
  class recover fallback
  classDef evaluation fill:#F1EFF9,stroke:#76628D,color:#22354F,stroke-width:1.2px
  class log evaluation
  classDef output fill:#EAF1FC,stroke:#3B66A2,color:#22354F,stroke-width:1.2px
